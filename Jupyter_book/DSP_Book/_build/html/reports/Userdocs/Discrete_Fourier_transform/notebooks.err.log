import numpy as np
import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

# Параметры сигнала
N = 64  # Количество точек
Fs = 1000  # Частота дискретизации (Гц)
t = np.arange(N) / Fs  # Временная шкала

# Создание тестового сигнала (сумма трёх гармоник)
freqs = [10, 30, 60]  # Частоты компонент (Гц)
amps = [1.0, 0.6, 0.3]  # Амплитуды
signal = np.zeros(N)
for freq, amp in zip(freqs, amps):
    signal += amp * np.sin(2 * np.pi * freq * t)
    signal += 0.8 * amp * np.cos(2 * np.pi * freq * t)  # Добавляем косинусоидальные компоненты

# Прямое дискретное преобразование Фурье (DFT)
dft_result = np.zeros(N, dtype=complex)
for k in range(N):
    for n in range(N):
        angle = -2 * np.pi * k * n / N
        dft_result[k] += signal[n] * (np.cos(angle) + 1j * np.sin(angle))

# Вычисление амплитуд и фаз
amplitudes = np.abs(dft_result) / N
phases = np.angle(dft_result)

# Восстановление сигнала через обратное DFT
reconstructed = np.zeros(N)
components = []

for k in range(N):
    # Создаем комплексную экспоненту для текущей частоты
    comp_real = np.zeros(N)
    comp_imag = np.zeros(N)
    
    for n in range(N):
        angle = 2 * np.pi * k * n / N
        comp_real[n] = np.cos(angle) * dft_result[k].real / N
        comp_imag[n] = np.sin(angle) * dft_result[k].imag / N
    
    # Сохраняем компоненты
    components.append((comp_real, comp_imag))
    reconstructed += comp_real + comp_imag

# Визуализация
plt.figure(figsize=(16, 12))
gs = GridSpec(4, 2)

# Исходный и восстановленный сигнал
ax0 = plt.subplot(gs[0, :])
ax0.plot(t, signal, 'b-', linewidth=2, label='Исходный сигнал')
ax0.plot(t, reconstructed, 'r--', linewidth=1.5, label='Восстановленный')
ax0.set_title('Исходный и восстановленный сигнал')
ax0.set_xlabel('Время (с)')
ax0.set_ylabel('Амплитуда')
ax0.legend()
ax0.grid(True)

# Выборка ключевых компонент для визуализации
key_components = [0, 10, 30, 60]  # Нулевая, 10 Гц, 30 Гц, 60 Гц
colors = ['red', 'green', 'blue', 'purple']
titles = ['Постоянная составляющая (DC)', 'Компонента 10 Гц', 'Компонента 30 Гц', 'Компонента 60 Гц']

for i, (comp_idx, color, title) in enumerate(zip(key_components, colors, titles)):
    ax = plt.subplot(gs[i+1, 0])
    comp_real, comp_imag = components[comp_idx]
    
    ax.plot(t, comp_real, 'g-', label=f'Косинусная ({amplitudes[comp_idx]:.2f})')
    ax.plot(t, comp_imag, 'b-', label=f'Синусная ({amplitudes[comp_idx]:.2f})')
    ax.plot(t, comp_real + comp_imag, 'm--', label='Сумма')
    
    ax.set_title(title)
    ax.set_xlabel('Время (с)')
    ax.set_ylabel('Амплитуда')
    ax.legend()
    ax.grid(True)
    ax.set_ylim(-0.5, 0.5)

# Амплитудный спектр
ax_last = plt.subplot(gs[1:, 1])
freqs = np.arange(N) * Fs / N
ax_last.stem(freqs[:N//2], amplitudes[:N//2], 'b-', markerfmt='bo', basefmt=' ')
ax_last.set_title('Амплитудный спектр сигнала')
ax_last.set_xlabel('Частота (Гц)')
ax_last.set_ylabel('Амплитуда')
ax_last.grid(True)
ax_last.set_xlim(0, Fs/2)

plt.tight_layout()
plt.show()
